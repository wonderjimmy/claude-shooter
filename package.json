{
  "name": "claude-shooter",
  "private": true,
  "version": "0.2.0",
  "description": "Carrion IX \u2014 a bio-mechanical shoot-'em-up that runs in any browser (Canvas 2D, keyboard / touch / gamepad)",
  "author": "Jimmy",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --mac",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.jimmy.claudeshooter",
    "productName": "Carrion IX",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": "dmg",
      "icon": "src-tauri/icons/icon.icns"
    },
    "dmg": {
      "title": "Carrion IX ${version}"
    }
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0"
  }
}
