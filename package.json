{
  "name": "claude-shooter",
  "private": true,
  "version": "0.0.1",
  "description": "Browser-based bio-mechanical horizontal shoot-'em-up",
  "author": "Jimmy",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --mac",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.jimmy.claudeshooter",
    "productName": "Claude Shooter",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": "dmg",
      "icon": "src-tauri/icons/icon.icns"
    },
    "dmg": {
      "title": "Claude Shooter ${version}"
    }
  }
}
